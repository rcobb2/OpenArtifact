# Colgate App Foundry — copy to `.env` and fill in. Never commit the result.
#
#   cp .env.example .env && $EDITOR .env
#
# Generate the two random secrets with:
#   COOKIE_SECRET:            openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#   PUBLISHER_INTERNAL_TOKEN: openssl rand -hex 32
#   TOKEN_ENCRYPTION_KEY:     openssl rand -hex 32
#   DEX_CLIENT_SECRET:        openssl rand -hex 32
#   CLAUDE_MCP_CLIENT_SECRET: openssl rand -hex 32

# ---------------------------------------------------------------- the host
# The public hostname. One DNS record, one certificate, everything behind it.
FOUNDRY_HOST=foundry.colgate.edu
# Contact address for Let's Encrypt expiry notices. Optional but recommended.
ACME_EMAIL=

# ------------------------------------------------------------ gallery admins
# Comma-separated @colgate.edu addresses allowed to change global vault
# settings (git backup, Drive config) and to rename or delete shared folders.
# Everyone else gets a read/publish-only gallery.
FOUNDRY_ADMINS=rcobb@colgate.edu

# Hosts a published app's launch_url may point at. Anything else is rejected,
# so a gallery card cannot become an open redirect.
LAUNCH_URL_HOSTS=script.google.com,apps.powerapps.com,make.powerapps.com

# ------------------------------------------------------------------ secrets
# oauth2-proxy session cookie key. Must be exactly 32 bytes, base64url.
COOKIE_SECRET=
# Shared between dex and oauth2-proxy for the `oauth2-proxy` static client.
DEX_CLIENT_SECRET=
# Shared between the gallery and publisher-mcp for service-to-service imports.
PUBLISHER_INTERNAL_TOKEN=
# Encrypts the stored Google refresh tokens at rest. 32 bytes, hex.
TOKEN_ENCRYPTION_KEY=
# Secret for the `claude-foundry` static client; entered into Claude's
# connector settings alongside the client id.
CLAUDE_MCP_CLIENT_SECRET=

# ------------------------------------------------- Google Workspace (Colgate)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
#   - Application type: Web application
#   - User type:        Internal  (restricts to colgate.edu)
#   - Authorized redirect URI: https://<FOUNDRY_HOST>/dex/callback
#                              https://<FOUNDRY_HOST>/link/google/callback
# The same client serves both Dex sign-in and the Apps Script link flow.
# Enable the "Apps Script API" on the project for publishing to work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------- Microsoft Entra ID (Colgate)
# Entra admin center > App registrations > New registration
#   - Supported account types: Single tenant
#   - Redirect URI (Web):      https://<FOUNDRY_HOST>/dex/callback
#   - Token configuration:     add optional claims `email` and `upn` on the ID token
#   - API permissions:         Microsoft Graph > User.Read (delegated)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Directory (tenant) ID — the UUID, not the domain. Pinning this is what
# restricts sign-in to institutional accounts.
COLGATE_ENTRA_TENANT_ID=
